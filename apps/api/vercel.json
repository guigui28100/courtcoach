{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- .",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [{ "path": "/api/cron/purge", "schedule": "30 2 * * *" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "includeFiles": "{dist/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  }
}
