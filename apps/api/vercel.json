{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "{dist/**,prisma/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  }
}
