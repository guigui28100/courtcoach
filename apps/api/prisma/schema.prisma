// Base de données CourtCoach – Tennis Club Houdan.
// Règle d'or : on ne garde que le nécessaire, et tout peut être exporté ou supprimé (RGPD).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH      // créé uniquement par le club (jamais en inscription libre)
  ADULT      // adhérent adulte
  GUARDIAN   // parent ou responsable légal d'un jeune du Centre
  YOUTH      // compte d'un jeune, ouvert sur invitation du coach (facultatif)
}

enum Axis {
  TECHNIQUE
  TACTIQUE
  PHYSIQUE
  MENTAL
}

enum ConsentKind {
  PRIVACY_POLICY   // politique de confidentialité lue
  FOLLOW_UP        // suivi sportif (objectifs, évaluations, bulletins)
  IMAGE            // droit à l'image (filmer pour analyser)
  HEALTH           // informations de santé facultatives
  ACCOUNT          // compte en ligne
}

enum LessonStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum GoalStatus {
  ACHIEVED      // atteint
  IN_PROGRESS   // en progrès
  NOT_ACHIEVED  // pas atteint
}

enum VideoStatus {
  WAITING     // à analyser
  ANALYSED
  REFERENCE   // modèle du coach
  FOLLOW_UP   // vidéo d'un jeune du Centre
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role
  firstName     String?
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  mustChangePassword Boolean @default(false) // mot de passe provisoire donné par le coach : à changer à la première connexion
  lockedUntil   DateTime?
  deletedAt     DateTime?
  totpSecret    String?   // clé de la double authentification (chiffrée)
  totpEnabled   Boolean   @default(false)
  totpLastStep  Int?      // dernier code utilisé (un code ne sert qu'une fois)
  recoveryCodes String[]  // codes de secours (empreintes)

  refreshTokens RefreshToken[]
  accesses      PlayerAccess[]
  lessons       LessonRequest[]
  videos        Video[]
  consents      Consent[]
  invitations   Invitation[]   @relation("InvitedBy")
  auditLogs     AuditLog[]
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Fiche d'un jeune du Centre de compétition jeunes (créée par le coach)
model Player {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String    @default("")
  birthDate        DateTime?
  sex              String?
  club             String?
  licence          String?
  heightCm         Int?
  ranking          String?
  targetRanking    String?
  hand             String?
  backhand         String?
  playStyle        String?
  training         String?
  availability     String?
  health           String?   // facultatif, sensible : jamais visible hors coach et responsables
  coachNotes       String?   // notes privées du coach : jamais visibles par la famille
  createdAt        DateTime  @default(now())
  lastActivityAt   DateTime  @default(now())
  archivedAt       DateTime?

  accesses    PlayerAccess[]
  consents    Consent[]
  goals       Goal[]
  evaluations Evaluation[]
  selfEvaluations SelfEvaluation[]
  courseStars CourseStar[]
  declaredMatches DeclaredMatch[]
  matches     Match[]
  videos      Video[]
  analyses    Analysis[]
  invitations Invitation[]
}

// Qui (parent, jeune) peut voir la fiche d'un joueur, en lecture seule
model PlayerAccess {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  relation   String  // « parent », « jeune »
  createdAt  DateTime @default(now())

  @@unique([userId, playerId])
}

// Invitation envoyée par le coach (lien à usage unique, durée limitée)
model Invitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  role        Role
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Preuve des accords (RGPD) : qui a accepté quoi, quand, et retrait éventuel
model Consent {
  id           String      @id @default(cuid())
  kind         ConsentKind
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  playerId     String?
  player       Player?     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  givenBy      String      // nom du responsable légal ou de la personne
  method       String      @default("online") // « online » ou « paper » (formulaire signé)
  policyVersion String     @default("2026-10")
  grantedAt    DateTime    @default(now())
  withdrawnAt  DateTime?

  @@index([playerId, kind])
}

model Goal {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season     String   // « 2026-2027 »
  axis       Axis
  title      String
  indicator  String   @default("")
  deadline   DateTime?
  progress   Int      @default(0)   // où il en est aujourd'hui (= dernier point de contrôle)
  trimesters Int[]    @default([])  // trimestres où l'objectif est à travailler (vide = toute la saison)
  createdAt  DateTime @default(now())
  analyses   AnalysisGoal[]
  checkpoints GoalCheckpoint[]

  @@index([playerId, season])
}

// Point de contrôle d'un objectif à la fin d'un trimestre : où le jeune en est, et la note du coach (garde l'historique pour le bulletin)
model GoalCheckpoint {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  trimester Int      // 1, 2 ou 3
  status    GoalStatus @default(IN_PROGRESS) // bilan de l'objectif à la fin du trimestre
  progress  Int      @default(0)
  comment   String   @default("")
  updatedAt DateTime @updatedAt

  @@unique([goalId, trimester])
}

model Evaluation {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season       String
  trimester    Int      // 0 = bilan de début d'année, 1, 2 ou 3 = bulletin du trimestre
  ratings      Json     @default("{}") // { competence: 1..5 }
  comments     Json     @default("{}") // { axe: texte }
  strengths    String   @default("")
  improve      String   @default("")
  next         String   @default("")
  appreciation String   @default("")
  updatedAt    DateTime @updatedAt

  @@unique([playerId, season, trimester])
}

// Match déclaré PAR le jeune (avec des choix proposés). Visible du jeune et du coach seulement, jamais des parents.
// Le jeune peut le corriger ou le supprimer pendant 7 jours, ensuite il est figé. Sans nom d'adversaire (vie privée).
model DeclaredMatch {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day        String   // « AAAA-MM-JJ »
  kind       String   // tournoi, plateau, equipes, amical, entrainement
  event      String   @default("") // nom du tournoi ou du lieu (60 caractères maximum)
  result     String   // Victoire | Défaite
  score      String   @default("")
  opponent   String   // plus-fort, pareil, moins-fort
  feeling    Int      // 1 à 5
  wellDone   String[] // jusqu'à 2 points forts (identifiants proposés)
  toImprove  String?  // 1 point à améliorer (identifiant proposé)
  coachComment String @default("") // réponse du coach (300 caractères maximum)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([playerId, day])
}

// Étoiles données par le coach à la fin d'un cours : toujours positives (1 à 3), pour l'effort, l'attitude, un progrès…
model CourseStar {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  day       String   // jour du cours « AAAA-MM-JJ » (plusieurs lignes possibles le même jour : une par raison / domaine, 6 au maximum)
  stars     Int      // 1, 2 ou 3
  reason    String   // identifiant d'une raison proposée (effort, ecoute, progres…)
  domain    String?  // domaine du radar fait grandir par l'étoile (technique, tactique, physique, mental, attitude) ; vide pour les anciennes étoiles
  comment   String   @default("") // petit mot du coach (140 caractères maximum)
  createdAt DateTime @default(now())

  @@index([playerId, day])
}

// Auto-évaluation du jeune en fin de trimestre : choix pré-enregistrés (identifiants) + un mot libre court.
// Brouillon visible du jeune et de sa famille ; le coach ne la voit qu'une fois ENVOYÉE (sentAt).
model SelfEvaluation {
  id        String    @id @default(cuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season    String
  trimester Int       // 1, 2 ou 3
  mood      Int?      // 1 à 5 (météo du trimestre)
  ratings   Json      @default("{}") // { axe: 1..5 } ressenti par grand domaine
  goals     Json      @default("{}") // { goalId: ACHIEVED | IN_PROGRESS | NOT_ACHIEVED }
  proud     String[]  // identifiants de phrases (« ma fierté »)
  improve   String[]  // identifiants de phrases (« je veux progresser en »)
  wish      String[]  // identifiants de phrases (« j'aimerais »)
  comment   String    @default("")
  sentAt    DateTime?
  readAt    DateTime? // lu par le coach
  updatedAt DateTime  @updatedAt

  @@unique([playerId, season, trimester])
}

model Match {
  id         String   @id @default(cuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date       DateTime
  tournament String
  round      String   @default("")
  result     String   // « Victoire » ou « Défaite »
  score      String   @default("")
  remark     String   @default("")

  @@index([playerId, date])
}

model Video {
  id          String      @id @default(cuid())
  title       String
  shot        String      @default("autre")
  question    String      @default("")
  status      VideoStatus @default(WAITING)
  mimeType    String      @default("video/mp4")
  sizeBytes   Int         @default(0)   // taille annoncée au début de l'envoi, vérifiée à la fin
  chunkCount  Int         @default(0)
  complete    Boolean     @default(false) // faux tant que l'envoi n'est pas terminé
  recordedAt  DateTime    @default(now())
  seenAt      DateTime?   // date à laquelle l'élève / la famille a vu l'analyse
  deleteAfter DateTime?   // suppression automatique prévue
  fromCoach   Boolean     @default(false) // vidéo envoyée PAR le coach au joueur (démonstration, vidéo de son jeu…)
  ownerId     String?     // adulte à l'origine de la vidéo
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  playerId    String?
  player      Player?     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  analyses Analysis[]
  messages Message[]
  chunks   VideoChunk[]
  images   VideoImage[]

  @@index([ownerId])
  @@index([playerId])
}

// Image annotée par le coach (studio d'analyse) : suit la vidéo, donc supprimée avec elle (12 mois, retrait de l'accord image…).
model VideoImage {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  sizeBytes Int
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([videoId])
}

// Le fichier vidéo est gardé dans la base (région Europe), en morceaux de 2 Mo :
// pas de service de stockage supplémentaire, et les mêmes contrôles d'accès que le reste.
model VideoChunk {
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  index   Int
  data    Bytes

  @@id([videoId, index])
}

model Analysis {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  playerId     String?
  player       Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  observation  String   @default("")
  strengths    String   @default("")
  improve      String   @default("")
  exercises    Json     @default("[]")
  captures     Json     @default("[]") // clés de stockage des images annotées
  captureNotes Json     @default("{}")
  sentAt       DateTime?
  createdAt    DateTime @default(now())
  goals        AnalysisGoal[]
}

model AnalysisGoal {
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  goalId     String
  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([analysisId, goalId])
}

// Discussion : seulement attachée à une vidéo déjà analysée (pas de messagerie libre)
model Message {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())
}

model LessonRequest {
  id            String       @id @default(cuid())
  memberId      String
  member        User         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type          String       // individuel, duo, video
  objective     String
  days          String[]
  moment        String       @default("Peu importe")
  message       String       @default("")
  status        LessonStatus @default(PENDING)
  coachReply    String       @default("")
  answeredAt    DateTime?
  seenByMemberAt DateTime?
  createdAt     DateTime     @default(now())

  @@index([memberId])
}

// Journal des actions sensibles (qui a fait quoi) : demandé par la protection des données
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
